# ============================================================
# YouTube Archiver - environment configuration (Phase 0-1)
#
# Copy to `.env` and adjust. `.env` is gitignored.
# All ARCHIVE/CONFIG/LOG roots are mounted from the host (NAS-friendly,
# see requirement section 3): the app stores RELATIVE paths in the DB so
# the storage root can be moved (NAS -> external SSD) by changing only
# ARCHIVE_ROOT.
# ============================================================

# ---- Storage roots (host paths; mounted into containers) ----
# On a NAS, set these on the HOST side of the docker-compose volume mounts.
ARCHIVE_ROOT=/archive
CONFIG_ROOT=/config
LOG_ROOT=/logs
TAKEOUT_IMPORT_ROOT=/takeout_imports
OBSIDIAN_EXPORT_ROOT=/obsidian_export

# Takeout import-session retention (Phase 6E). Defaults 0 = disabled (sessions
# kept until you run `takeout sessions cleanup`). These only affect the
# import-SESSION history rows — never jobs and never imported liked/watch/search
# data. Set as defaults for the cleanup command.
TAKEOUT_IMPORT_SESSION_RETENTION_DAYS=0
TAKEOUT_IMPORT_SESSION_KEEP_LAST=0

# Takeout import-session AUTO cleanup (Phase 6F). When enabled, the scheduler
# prunes old SESSION rows (only; never jobs / imported data) at most every
# INTERVAL_HOURS using the retention/keep_last bounds above (needs at least one
# bound > 0). Default OFF.
TAKEOUT_IMPORT_SESSION_CLEANUP_ENABLED=false
TAKEOUT_IMPORT_SESSION_CLEANUP_INTERVAL_HOURS=24

# Build identity (Phase 6F). Optional — when unset, build_id is a content hash
# of the app/ source so web and worker built from the same tree match (a stale
# worker is detected by `archiver system preflight`). Set in CI for an explicit
# build id / commit / timestamp.
# APP_BUILD_ID=
# APP_GIT_COMMIT=
# APP_BUILD_TIME=

# Example NAS host paths (used by docker-compose volume mapping):
#   /Volume1/NAS/youtube-archiver/archive:/archive
#   /Volume1/NAS/youtube-archiver/config:/config
#   /Volume1/NAS/youtube-archiver/logs:/logs
ARCHIVE_HOST_PATH=./data/archive
CONFIG_HOST_PATH=./data/config
LOG_HOST_PATH=./data/logs
TAKEOUT_HOST_PATH=./data/takeout
OBSIDIAN_HOST_PATH=./data/obsidian

# ---- Database (PostgreSQL in Docker) ----
POSTGRES_USER=archiver
POSTGRES_PASSWORD=archiver
POSTGRES_DB=archiver
# SQLAlchemy URL. In docker-compose the host is `postgres`.
DATABASE_URL=postgresql+psycopg2://archiver:archiver@postgres:5432/archiver

# ---- Redis / RQ ----
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=archiver

# ---- yt-dlp / external tools ----
# Path to the yt-dlp binary (the pip-installed console script is on PATH).
YTDLP_BINARY=yt-dlp
# ffmpeg/ffprobe directory (the Docker image installs them on PATH; leave blank).
FFMPEG_LOCATION=
# Deno path for the YouTube challenge / EJS runtime (installed in the image).
DENO_PATH=/usr/local/bin/deno
# Remote components for the YouTube JS challenge (n-sig/signature) solver.
# Needed WITH a JS runtime (deno) to avoid throttling/403/"Signature solving
# failed". Always on by default (even if left blank); set to "none" to disable.
YTDLP_REMOTE_COMPONENTS=ejs:github
# ---- YouTube fetch-stabilization SECRETS (Phase 7A/7B/7I) ----
# These reduce HTTP 429 (rate_limited) when fetching metadata/body for the
# imported liked videos. They are SECRETS: NEVER commit real values to Git, and
# the app only ever reports "configured/readable" booleans (never the value or
# absolute path) in the API / UI / logs. Edit these yourself in your local .env.
#
# Cookies file (mounted secret). MUST NOT be committed. Leave blank to disable.
COOKIES_FILE=/secrets/cookies.txt
# OR read cookies from a local browser profile (e.g. "chrome", "firefox").
# COOKIES_FROM_BROWSER=
# YouTube PO token + visitor data (paired). Strong 429 mitigation. Secrets.
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=

# ---- Defaults ----
# Default profile for bare URL registration (and Discord DM, later phases).
DEFAULT_PROFILE=video_compressed_1080p
# Subtitle languages for normal profiles. DO NOT use "all": it makes YouTube
# serve hundreds of auto-translations and triggers HTTP 429 (Too Many Requests).
# Use EXACT codes, NOT regex like "en.*": yt-dlp anchors the pattern, so "en.*"
# matches every English auto-translation (en-de-DE, en-fr, ...) and ALSO 429s.
# Add exact codes as needed, e.g. "ja,en,en-US,en-orig".
DEFAULT_SUB_LANGS=ja,en
# Subtitle languages for the video_best_archive profile. Set to "all" for a
# complete (heavier, 429-prone) capture; otherwise keep the exact allow-list.
ARCHIVE_SUB_LANGS=ja,en
# Cap on comments fetched per video when --write-comments is active (0 = unlimited).
# Set a finite value (e.g. 5000) to avoid pulling millions from viral videos.
YTDLP_MAX_COMMENTS=0
# Cap for comments_refresh jobs (Phase 4A). Finite by default for safety;
# 0 = unlimited. Large/viral videos can have huge comment counts.
COMMENT_REFRESH_MAX_COMMENTS=200
# Safety cap when expanding a playlist/channel into download jobs (0 = unlimited).
EXPAND_MAX_ITEMS=0

# ---- Scheduler (Phase 2B / 4B) ----
# The `scheduler` container always runs, but each pass is a no-op unless enabled.
# SCHEDULER_ENABLED gates collection re-crawls; SCHEDULER_COMMENTS_ENABLED gates
# periodic comment refreshes. Each pass enqueues at most
# SCHEDULER_COMMENTS_LIMIT_PER_RUN due videos (next_comments_refresh_at <= now,
# excluding comments_disabled / unavailable / frozen).
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_COMMENTS_ENABLED=false
SCHEDULER_COMMENTS_LIMIT_PER_RUN=10

# ---- Comments refresh rate control / retry (Phase 4B) ----
# Sleep (seconds) before each comments/live-chat refresh job (spaces out
# requests; helps avoid HTTP 429). On 429 the job is marked retryable and the
# video's next_comments_refresh_at is pushed out by the backoff below.
COMMENTS_REFRESH_JOB_DELAY_SECONDS=0
COMMENTS_REFRESH_RETRY_BACKOFF_SECONDS=21600
# After this many consecutive 429 failures, back off at least a day.
COMMENTS_REFRESH_MAX_RETRY=5

# ---- Live chat (Phase 4B) ----
# Cap messages ingested per live_chat refresh (0 = unlimited). Live chats can be
# very large; a finite cap keeps a single refresh bounded.
LIVE_CHAT_MAX_MESSAGES=0
# Interval (seconds) before re-refreshing a video's live chat (default 30 days).
LIVE_CHAT_REFRESH_INTERVAL_SECONDS=2592000

# ---- Rate control / retry (Phase 2B) ----
# Sleep (seconds) before each download job starts. On a single worker this
# spaces out requests and helps avoid YouTube HTTP 429. e.g. 2 or 5.
DOWNLOAD_JOB_DELAY_SECONDS=0
# Passed to yt-dlp --retry-sleep (seconds between retries, e.g. on 429). e.g. 5.
YTDLP_RETRY_BACKOFF_SECONDS=0
# Intended download concurrency (informational with a single worker; scale with
# `docker compose up --scale worker=N`).
MAX_CONCURRENT_DOWNLOAD_JOBS=1
# Per-job-type delays (Phase 7A): throttle light refreshes apart from heavy DLs.
METADATA_REFRESH_JOB_DELAY_SECONDS=0
SUBTITLES_REFRESH_JOB_DELAY_SECONDS=0

# ---- Download retry / backoff (Phase 7A) ----
# Retryable failures (429 / Incomplete data received / fragments) schedule a
# backoff retry up to MAX_ATTEMPTS (prevents infinite retry). The scheduler can
# auto-pick them up (SCHEDULER_RETRY_ENABLED) or retry manually via the UI/CLI.
DOWNLOAD_RETRY_MAX_ATTEMPTS=5
DOWNLOAD_RETRY_BACKOFF_SECONDS=600
DOWNLOAD_RETRY_BACKOFF_MULTIPLIER=2.0
DOWNLOAD_RETRY_JITTER_SECONDS=60
SCHEDULER_RETRY_ENABLED=false
SCHEDULER_RETRY_LIMIT_PER_RUN=10
# Subtitles-only refresh languages (empty -> DEFAULT_SUB_LANGS). NOT "all".
SUBTITLES_REFRESH_SUB_LANGS=

# ---- Liked metadata-run safety (Phase 7I) ----
# `liked-videos metadata-run` fetches metadata (no body) in capped batches and
# STOPS a staged/full run if the 429 (rate_limited) ratio gets too high.
LIKED_METADATA_MAX_ENQUEUE_PER_RUN=200      # per-batch cap (metadata is light)
LIKED_METADATA_JOB_DELAY_SECONDS=3.0        # extra delay per metadata job (Phase 7L: 1.5->3.0 to reduce deep-region 429)
LIKED_METADATA_JOB_DELAY_JITTER_SECONDS=1.0 # Phase 7L: add random 0..N s so requests aren't perfectly periodic
LIKED_METADATA_WARN_ON_RATE_LIMIT_RATIO=0.5 # WARN at >=50% rate_limited
LIKED_METADATA_STOP_ON_RATE_LIMIT_RATIO=0.8 # STOP a run at >=80% rate_limited

# ---- Liked-videos bulk archive (Phase 7C) ----
# Archive liked videos in SMALL batches (start with 10-30). A body archive
# downloads the video BODY; metadata_only does not.
LIKED_ARCHIVE_DEFAULT_LIMIT=20
# Hard safety cap on jobs created by one enqueue call.
LIKED_ARCHIVE_MAX_ENQUEUE_PER_RUN=50
# Profile used for a body archive (downloads the video body).
LIKED_ARCHIVE_DEFAULT_PROFILE=video_compressed_1080p
# Extra per-job throttle (seconds) applied to liked-archive download jobs.
LIKED_ARCHIVE_JOB_DELAY_SECONDS=0

# ---- Liked-archive scheduler passes (Phase 7D) — default OFF / small limits ----
# All passes are opt-in. Recommended limits: metadata 10-50, body archive 1-3, retry 1-5.
# metadata_only pass (no body DL):
SCHEDULER_LIKED_METADATA_ENABLED=false
SCHEDULER_LIKED_METADATA_LIMIT_PER_RUN=10
# body archive pass (DOWNLOADS the video body!): keep the limit tiny.
SCHEDULER_LIKED_ARCHIVE_ENABLED=false
SCHEDULER_LIKED_ARCHIVE_LIMIT_PER_RUN=2
SCHEDULER_LIKED_ARCHIVE_PROFILE=          # empty -> LIKED_ARCHIVE_DEFAULT_PROFILE
SCHEDULER_LIKED_ARCHIVE_SOURCE=           # empty -> all sources
SCHEDULER_LIKED_ARCHIVE_MISSING_BODY_ONLY=true
# retryable liked re-queue pass (respects next_retry_at backoff + attempt cap):
SCHEDULER_LIKED_RETRY_ENABLED=false
SCHEDULER_LIKED_RETRY_LIMIT_PER_RUN=3
# Skip a liked enqueue pass while liked-archive BODY jobs are still in flight.
SCHEDULER_LIKED_SUPPRESS_WHEN_ACTIVE=true

# ---- Scheduler run retention (Phase 7F) — default OFF (no auto-delete) ----
# When > 0, the scheduler loop prunes scheduler_runs older than N days and/or
# beyond the most-recent KEEP_LAST. 0 = keep everything. Jobs are NEVER deleted
# by retention. Manual cleanup: `archiver scheduler runs cleanup --keep-last N`.
SCHEDULER_RUN_RETENTION_DAYS=0
SCHEDULER_RUN_KEEP_LAST=0

# ---- YouTube fetch stabilization secrets (Phase 7A/7B) — values NEVER shown ----
# Read browser cookies instead of a cookies.txt (e.g. "chrome"). --cookies-from-browser
# Both COOKIES_FROM_BROWSER and YTDLP_COOKIES_FROM_BROWSER are accepted.
# NOTE: inside Docker there is usually no browser profile, so a cookies.txt is
# generally more reliable than --cookies-from-browser.
COOKIES_FROM_BROWSER=
# YTDLP_COOKIES_FROM_BROWSER=
# YouTube PO token (SECRET; masked in command.txt/logs). --extractor-args youtube:po_token=...
YOUTUBE_PO_TOKEN=
# YouTube visitor data (SECRET; pairs with the PO token). youtube:visitor_data=...
YOUTUBE_VISITOR_DATA=
# Raw extra extractor-args passthrough (non-secret tuning), e.g. youtube:player_client=web
YTDLP_EXTRACTOR_ARGS=

# ---- App ----
LOG_LEVEL=INFO

# ---- Web UI / CORS (Phase 5A) ----
# The admin SPA (frontend/dist) is served by FastAPI at "/" when present.
WEB_UI_ENABLED=true
# Override the built-UI directory (default: <repo>/frontend/dist, Docker: /app/frontend/dist).
WEB_UI_DIR=
# CORS allow-origins (comma separated). "*" = allow all (this is a local admin
# tool with no auth/cookies on the API). Set explicit origins to restrict, e.g.
# CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGINS=*

# ---- YouTube Data API OAuth (Phase 6B) — DEFAULT DISABLED ----
# The whole app starts and runs fully without any of this. Liked-videos full
# history comes from Google Takeout "My Activity"; the API is only the
# incremental top-up (practically ~5000 most-recent). Secrets are FILES (never
# committed, never shown by the API/UI).
YOUTUBE_API_ENABLED=false
# OAuth installed-app client secret JSON (download from Google Cloud Console).
# Place it under /secrets or /config (mounted), NOT in Git.
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=
# Stored OAuth token (created by `archiver youtube-api authorize`).
# Default: CONFIG_ROOT/youtube_oauth_token.json
YOUTUBE_OAUTH_TOKEN_FILE=
# Liked fetch method: videos (videos.list myRating=like) | playlist | auto
YOUTUBE_API_LIKED_METHOD=auto
