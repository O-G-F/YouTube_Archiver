# ============================================================
# YouTube Archiver - environment configuration (Phase 0-1)
#
# Copy to `.env` and adjust. `.env` is gitignored.
# All ARCHIVE/CONFIG/LOG roots are mounted from the host (NAS-friendly,
# see requirement section 3): the app stores RELATIVE paths in the DB so
# the storage root can be moved (NAS -> external SSD) by changing only
# ARCHIVE_ROOT.
# ============================================================

# ---- Storage roots (host paths; mounted into containers) ----
# On a NAS, set these on the HOST side of the docker-compose volume mounts.
ARCHIVE_ROOT=/archive
CONFIG_ROOT=/config
LOG_ROOT=/logs
TAKEOUT_IMPORT_ROOT=/takeout_imports
OBSIDIAN_EXPORT_ROOT=/obsidian_export

# Example NAS host paths (used by docker-compose volume mapping):
#   /Volume1/NAS/youtube-archiver/archive:/archive
#   /Volume1/NAS/youtube-archiver/config:/config
#   /Volume1/NAS/youtube-archiver/logs:/logs
ARCHIVE_HOST_PATH=./data/archive
CONFIG_HOST_PATH=./data/config
LOG_HOST_PATH=./data/logs
TAKEOUT_HOST_PATH=./data/takeout
OBSIDIAN_HOST_PATH=./data/obsidian

# ---- Database (PostgreSQL in Docker) ----
POSTGRES_USER=archiver
POSTGRES_PASSWORD=archiver
POSTGRES_DB=archiver
# SQLAlchemy URL. In docker-compose the host is `postgres`.
DATABASE_URL=postgresql+psycopg2://archiver:archiver@postgres:5432/archiver

# ---- Redis / RQ ----
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=archiver

# ---- yt-dlp / external tools ----
# Path to the yt-dlp binary (the pip-installed console script is on PATH).
YTDLP_BINARY=yt-dlp
# ffmpeg/ffprobe directory (the Docker image installs them on PATH; leave blank).
FFMPEG_LOCATION=
# Deno path for the YouTube challenge / EJS runtime (installed in the image).
DENO_PATH=/usr/local/bin/deno
# Remote components for the YouTube JS challenge (n-sig/signature) solver.
# Needed WITH a JS runtime (deno) to avoid throttling/403/"Signature solving
# failed". Always on by default (even if left blank); set to "none" to disable.
YTDLP_REMOTE_COMPONENTS=ejs:github
# Cookies file (mounted secret). MUST NOT be committed. Leave blank to disable.
COOKIES_FILE=/secrets/cookies.txt

# ---- Defaults ----
# Default profile for bare URL registration (and Discord DM, later phases).
DEFAULT_PROFILE=video_compressed_1080p
# Subtitle languages for normal profiles. DO NOT use "all": it makes YouTube
# serve hundreds of auto-translations and triggers HTTP 429 (Too Many Requests).
# Use EXACT codes, NOT regex like "en.*": yt-dlp anchors the pattern, so "en.*"
# matches every English auto-translation (en-de-DE, en-fr, ...) and ALSO 429s.
# Add exact codes as needed, e.g. "ja,en,en-US,en-orig".
DEFAULT_SUB_LANGS=ja,en
# Subtitle languages for the video_best_archive profile. Set to "all" for a
# complete (heavier, 429-prone) capture; otherwise keep the exact allow-list.
ARCHIVE_SUB_LANGS=ja,en
# Cap on comments fetched per video when --write-comments is active (0 = unlimited).
# Set a finite value (e.g. 5000) to avoid pulling millions from viral videos.
YTDLP_MAX_COMMENTS=0
# Safety cap when expanding a playlist/channel into download jobs (0 = unlimited).
EXPAND_MAX_ITEMS=0

# ---- Scheduler (Phase 2B) ----
# The `scheduler` container always runs, but each pass is a no-op unless enabled.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600

# ---- Rate control / retry (Phase 2B) ----
# Sleep (seconds) before each download job starts. On a single worker this
# spaces out requests and helps avoid YouTube HTTP 429. e.g. 2 or 5.
DOWNLOAD_JOB_DELAY_SECONDS=0
# Passed to yt-dlp --retry-sleep (seconds between retries, e.g. on 429). e.g. 5.
YTDLP_RETRY_BACKOFF_SECONDS=0
# Intended download concurrency (informational with a single worker; scale with
# `docker compose up --scale worker=N`).
MAX_CONCURRENT_DOWNLOAD_JOBS=1

# ---- App ----
LOG_LEVEL=INFO
