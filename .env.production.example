# =====================================================================
# YouTube Archiver — PRODUCTION environment template (Phase 9B)
# =====================================================================
# Copy to `.env` on the production host and fill in real values.
# NEVER commit `.env` (it is gitignored). This file contains NO secret
# values — only key names and guidance.
#
# Run `archiver system production-check` after configuring; it must be
# PASS (WARN is acceptable only if you understand each warning).
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------
# PostgreSQL (do NOT use the sqlite dev default in production).
DATABASE_URL=postgresql+psycopg2://archiver:CHANGE_ME@postgres:5432/archiver
POSTGRES_USER=archiver
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=archiver

# Redis (RQ queue). AOF persistence is enabled in docker-compose.yml
# (--appendonly yes) so queued/running jobs survive a restart / host sleep.
REDIS_URL=redis://redis:6379/0

# Storage roots on the HOST (NAS / external SSD friendly). Only the *_HOST_PATH
# change when you move storage; container paths stay constant.
ARCHIVE_HOST_PATH=/srv/youtube-archiver/archive
CONFIG_HOST_PATH=/srv/youtube-archiver/config
LOG_HOST_PATH=/srv/youtube-archiver/logs
TAKEOUT_HOST_PATH=/srv/youtube-archiver/takeout

# ---------------------------------------------------------------------
# RECOMMENDED
# ---------------------------------------------------------------------
# Production body-archive profile: comments-light avoids DB `comments` bloat.
# Do NOT set this to a comments-enabled profile for bulk archiving.
BODY_ARCHIVE_DEFAULT_PROFILE=video_compressed_1080p_light

# Disk capacity guard: keep this comfortably high. A body-archive run that would
# drop the archive volume below this is REFUSED (override only with --allow-low-disk).
ARCHIVE_MIN_FREE_GB=500
ARCHIVE_SIZE_ESTIMATE_FALLBACK_MB=300
ARCHIVE_SIZE_ESTIMATE_MIN_SAMPLES=10

# Per-run body enqueue cap (safety brake; --limit is the real control).
LIKED_ARCHIVE_MAX_ENQUEUE_PER_RUN=1000

# YouTube fetch stabilization (reduces 429). SECRETS — do not put values here;
# see "SECRETS placement" below. These lines only NAME the settings.
#   COOKIES_FILE=/secrets/cookies.txt          # mounted read-only from ./secrets
#   YOUTUBE_PO_TOKEN=...                        # keep out of git / logs
#   YOUTUBE_VISITOR_DATA=...
# Rate throttle for liked metadata jobs.
LIKED_METADATA_JOB_DELAY_SECONDS=3.0
LIKED_METADATA_JOB_DELAY_JITTER_SECONDS=1.0

# Restrict the admin UI/API origin (do NOT use * in production; use your real
# domain, e.g. https://archiver.example.com). Wildcard fails production-check.
CORS_ALLOW_ORIGINS=https://archiver.example.com

# ---- Access control / auth (Phase 9C) — REQUIRED in production ----
APP_ENV=production
# local: in-app admin password login.  trusted_proxy: authenticate at a reverse
# proxy (e.g. Cloudflare Access) and pass an identity header.  disabled FAILS
# production-check.
AUTH_MODE=local
# Session cookie MUST be Secure in production (HTTPS). SameSite=strict recommended.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
SESSION_MAX_AGE_SECONDS=28800
# --- local mode secrets (VALUES never go in git/env/README) ---
# Generate and store under ./secrets (mounted read-only at /secrets):
#   archiver auth gen-session-secret > ./secrets/session_secret
#   archiver auth hash-password      > ./secrets/admin_password_hash   # prompts; hash only
SESSION_SECRET_FILE=/secrets/session_secret
ADMIN_PASSWORD_HASH_FILE=/secrets/admin_password_hash
# --- trusted_proxy mode (only if AUTH_MODE=trusted_proxy) ---
# Accept the identity header ONLY from these proxy source CIDRs, and only for the
# allow-listed emails. Without CIDRs the header could be spoofed (production-check FAIL).
TRUSTED_PROXY_AUTH_HEADER=CF-Access-Authenticated-User-Email
TRUSTED_PROXY_CIDRS=              # e.g. Cloudflare ranges 173.245.48.0/20,103.21.244.0/22,...
ALLOWED_ADMIN_EMAILS=            # e.g. you@example.com
TRUST_FORWARDED_HEADERS=true      # trust X-Forwarded-* only from the trusted proxy

# ---- Ingress / release hardening (Phase 9D) — REQUIRED in production ----
# Host header allow-list (NO wildcard). production-check FAILs if empty in prod.
ALLOWED_HOSTS=archiver.example.com
# CSRF trusted browser origins — SEPARATE from CORS, no wildcard. Required for local auth.
CSRF_TRUSTED_ORIGINS=https://archiver.example.com
# Security headers (CSP/nosniff/frame/referrer/permissions). HSTS added in production only.
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
# Redis-backed login rate limit — shared across workers, TTL. Fail-CLOSED if Redis
# is down in production. Keys are HMAC-anonymised (no raw IP stored).
LOGIN_RATE_LIMIT_BACKEND=redis
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Backup freshness marker read by `release-check` (container path; mount the dir it
# lives in and let scripts/backup.sh touch the host-side file).
BACKUP_MARKER_FILE=/config/last_backup
BACKUP_MAX_AGE_HOURS=168
# Phase 9F backup integrity: manifest summary + verify / rehearsal markers
# (written by scripts/backup.sh, scripts/verify-backup.sh, scripts/restore-rehearsal.sh;
#  surfaced by release-check and the read-only backup-readiness panel).
BACKUP_MANIFEST_SUMMARY_FILE=/config/last_backup_manifest.json
BACKUP_VERIFIED_MARKER_FILE=/config/last_backup_verified
BACKUP_VERIFY_MAX_AGE_HOURS=336
RESTORE_REHEARSAL_MARKER_FILE=/config/last_restore_rehearsal
RESTORE_REHEARSAL_MAX_AGE_DAYS=90
# Phase 9F.1: HMAC key for the backup-set manifest integrity hash (detects manifest
# tampering; value/path never logged). Generate to ./secrets, e.g.:
#   archiver auth gen-session-secret > ./secrets/backup_manifest_hmac_key ; chmod 600 ...
BACKUP_MANIFEST_HMAC_KEY_FILE=/secrets/backup_manifest_hmac_key
# Phase 10A release / supply chain: release-manifest summary + HMAC key + vuln policy.
# APP_VERSION / APP_GIT_COMMIT / APP_GIT_TREE_CLEAN are baked as Docker build args by
# scripts/build-release.sh (a dirty or 0.0.0-dev build FAILs release-check in production).
RELEASE_MANIFEST_SUMMARY_FILE=/config/last_release_manifest.json
RELEASE_MANIFEST_HMAC_KEY_FILE=/secrets/release_manifest_hmac_key
RELEASE_SCANNER_UNAVAILABLE_POLICY=fail
RELEASE_MAX_CRITICAL_VULNERABILITIES=0
# Phase 10A.1: vulnerability DB max age (days) before release-check flags it stale.
RELEASE_VULN_DB_MAX_AGE_DAYS=7
# Optional PREVIOUS session secret (verification-only) during session-secret rotation.
# SESSION_SECRET_PREVIOUS_FILE=/secrets/session_secret_previous
# Loopback host port for docker-compose.production.yml (bound to 127.0.0.1 only).
WEB_HOST_PORT=8000

# ---- Audit trail / observability (Phase 9E) — REQUIRED in production ----
AUDIT_ENABLED=true
# HMAC key for the tamper-evident audit chain (REQUIRED in prod; production-check
# FAILs without it). Generate a high-entropy secret to ./secrets, e.g.:
#   archiver auth gen-session-secret > ./secrets/audit_hmac_key ; chmod 600 ./secrets/audit_hmac_key
AUDIT_HMAC_KEY_FILE=/secrets/audit_hmac_key
# Short id for the CURRENT signing key (never the key value/path). REQUIRED in prod.
AUDIT_HMAC_KEY_ID=k1
# Previous keys for verification-only after rotation (comma lists; counts must match).
#   1) set the NEW key as current + the OLD key here, then: archiver audit rotate-key --apply
# AUDIT_HMAC_PREVIOUS_KEY_FILES=/secrets/audit_hmac_key_old
# AUDIT_HMAC_PREVIOUS_KEY_IDS=k0
# Pseudonymisation key — SEPARATE from the signing key so rotation keeps pseudonyms stable.
AUDIT_PSEUDONYM_KEY_FILE=/secrets/audit_pseudonym_key
# Production must not carry an unsigned legacy prefix unless explicitly allowed.
AUDIT_ALLOW_LEGACY_UNSIGNED_PREFIX=false
AUDIT_RETENTION_DAYS=365
AUDIT_SECURITY_RETENTION_DAYS=730
AUDIT_MAX_EXPORT_EVENTS=100000
# Metrics require auth (served under /api/*). Never expose /api/system/metrics publicly.
METRICS_REQUIRE_AUTH=true
# Structured JSON logs (redacted) — recommended for log shipping.
STRUCTURED_LOGGING=true
# Public HTTPS URL — HTTPS readiness is judged from THIS + proxy config (not HSTS).
PUBLIC_BASE_URL=https://archiver.example.com

# ---------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Scheduler passes are OFF by default; enable deliberately with small limits.
SCHEDULER_ENABLED=false
SCHEDULER_LIKED_ARCHIVE_ENABLED=false
SCHEDULER_LIKED_ARCHIVE_LIMIT_PER_RUN=2
# empty -> BODY_ARCHIVE_DEFAULT_PROFILE (comments-light)
SCHEDULER_LIKED_ARCHIVE_PROFILE=

# ---------------------------------------------------------------------
# SECRETS placement (values NEVER go in git or this file)
# ---------------------------------------------------------------------
# * cookies.txt        -> put under ./secrets/ ; it is mounted read-only at
#                         /secrets inside the containers. Set COOKIES_FILE=/secrets/cookies.txt.
# * OAuth client/token -> under CONFIG_HOST_PATH (/config); never commit.
# * PO-token / visitor data -> set as env vars on the host only.
# The API/UI report only booleans (configured / readable) — never the values.
#
# ---------------------------------------------------------------------
# DEV-ONLY / DANGEROUS settings — DO NOT enable in production
# ---------------------------------------------------------------------
# * AUTH_MODE=disabled           -> unauthenticated admin API/UI (production-check FAIL).
# * SESSION_COOKIE_SECURE=false  -> session cookie sent over plain HTTP (FAIL in prod).
# * plaintext password / secret in env or git -> NEVER; use the secret files above.
# * exposing container port 8000 directly to the internet -> put it behind the
#   reverse proxy (Cloudflare tunnel / nginx) and bind 8000 to localhost only.
# * ARCHIVE_MIN_FREE_GB=0        -> disables the disk guard (can fill the disk).
# * routine `--allow-low-disk`   -> bypasses the disk guard; use only as a one-off.
# * LOG_LEVEL=DEBUG              -> verbose; may surface noisy internals.
# * CORS_ALLOW_ORIGINS=*         -> open CORS on the admin API.
# * comments-enabled body profile at scale (video_compressed_1080p) -> DB bloat.
# * storing raw_json on import   -> keep raw_json stored total = 0 (use --no-raw-json).
# `archiver system production-check` flags these as WARN/FAIL.
